# --- data does not belong in Git ---
# ...with one deliberate exception: dvc/data.zip is committed so the tutorial is
# self-contained for anyone who clones this repo. See the note in README.md.
data/
photos/
*.pkl
*.joblib

# sandboxes the notebooks create when you run them
# every notebook builds one of these beside itself and deletes it in the last cell.
# all fifteen are listed, so an interrupted run cannot leak a sandbox into a commit.
api_demo/
auto_demo/
dl_demo/
docker_demo/
dvc_demo/
dvc_remote/
e2e_demo/
e2e_dvc_remote/
etl_demo/
feast_demo/
leakage_demo/
mlflow_demo/
mon_demo/
ray_demo/
tf_demo/

# MLflow local stores
mlruns/
mlartifacts/
mlflow.db

# DVCLive output
dvclive/

# python / jupyter
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# build and check scripts: kept locally, not shipped
tools/
